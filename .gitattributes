# Audio goes through LFS. These tracks are placeholders and will be swapped,
# and every swap of a 5 MB binary would otherwise sit in the repo history
# forever. LFS keeps the code clone small.
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
