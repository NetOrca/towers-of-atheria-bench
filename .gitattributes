# Audio goes through LFS. These tracks are placeholders and will be swapped,
# and every swap of a 5 MB binary would otherwise sit in the repo history
# forever. LFS keeps the code clone small.
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text

# Shipped builds go through LFS for the same reason. GitHub is the archive -
# EVERY version of the game is kept here, forever - while itch.io only ever
# carries the current one. Three megabytes a release adds up fast in history,
# and none of it is diffable, so it belongs in LFS rather than in the tree.
*.zip  filter=lfs diff=lfs merge=lfs -text
